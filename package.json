{
  "name": "@i19n/platform",
  "version": "0.0.0",
  "description": "i19n project",
  "productName": "i19n",
  "homepage": "https://github.com/i19n-io/platform",
  "repository": "i19n-io/platform",
  "author": "Vova Revenko <vova@revenko.org>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "codegen": "graphql-codegen --config codegen.config.ts",
    "codegen:watch": "npm run codegen -- --watch",
    "check": "run-p --continue-on-error check:*",
    "check:code": "eslint . --max-warnings 0",
    "check:format": "prettier . --check",
    "check:spelling": "cspell lint",
    "check:spelling-unused": "cspell-check-unused-words",
    "check:types": "vue-tsc --noEmit",
    "fix": "run-s fix:*",
    "fix:code": "npm run check:code -- --fix",
    "fix:format": "npm run check:format -- --write",
    "fix:spelling-unused": "npm run check:spelling-unused -- --fix",
    "test": "echo \"No test specified\" && exit 0"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "graphql": "^16.11.0",
    "pinia": "^3.0.3",
    "quasar": "^2.18.5",
    "villus": "^3.5.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@parcel/watcher": "^2.5.1",
    "@quasar/app-vite": "^2.4.0",
    "@types/node": "^24.9.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "autoprefixer": "^10.4.21",
    "cspell": "^9.2.1",
    "cspell-check-unused-words": "^1.5.4",
    "eslint": "^9.38.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-consistent-default-export-name": "^0.0.15",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-node-import": "^1.0.5",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.5.4",
    "vite-plugin-checker": "^0.10.3",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  }
}
